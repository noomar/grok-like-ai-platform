# ----------------------------------------------------------------------------
# Aurora platform — environment configuration
# Copy to .env.local (local) or configure on Vercel → Project → Settings → Env.
# ----------------------------------------------------------------------------

# REQUIRED — admin panel login password (default "aurora-admin" in dev only).
ADMIN_PASSWORD=

# REQUIRED for real TTS via OpenAI (gpt-4o-mini-tts).
# Without this, production jobs fail with "Missing Key: OPENAI_API_KEY".
OPENAI_API_KEY=

# RECOMMENDED for persistent downloadable MP4s on Vercel.
# Create at Vercel dashboard → Storage → Blob. Without it, MP4s are written to
# /tmp and only downloadable from the same serverless instance that rendered them.
BLOB_READ_WRITE_TOKEN=

# OPTIONAL — alternative hosted video renderer (Shotstack free tier).
# Not required; pipeline uses local ffmpeg + Pollinations.ai by default.
SHOTSTACK_API_KEY=

# OPTIONAL — alternative TTS provider (not wired by default).
ELEVENLABS_API_KEY=

# --------------------------------------------------------------------------
# Heartbeat — auto-emails you on every boot/migration with live URL + password
# --------------------------------------------------------------------------
# Email via Resend (free, https://resend.com/signup → API Keys → Create)
RESEND_API_KEY=
EMAIL_TO=i.y.asikral7@gmail.com
HEARTBEAT_INCLUDE_PASSWORD=true

# Email via generic SMTP (alternative to Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Telegram (optional, in addition to email)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Public URL (set after you configure a tunnel/domain)
# AURORA_PUBLIC_URL=https://empire.example.com

# Encrypted backups (for scripts/backup-nest.sh)
# BACKUP_GPG_PASSPHRASE=
# BACKUP_DEST=local:./backups
